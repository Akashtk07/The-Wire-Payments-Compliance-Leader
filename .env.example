# ============================================================
# THE COMPLIANCE LEADER — Environment Configuration Template
# Copy this file to .env and populate values before running.
#
# ⚠️  GMAIL APP PASSWORD SETUP:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to Security → 2-Step Verification → App Passwords
#   4. Select app: "Mail", device: "Other" → name it "Compliance Leader"
#   5. Copy the 16-character password (format: xxxx xxxx xxxx xxxx)
#   6. Set SMTP_USERNAME=your@gmail.com and SMTP_PASSWORD=xxxxxxxxxxxxxxxx
#   NOTE: Use your Gmail address as SMTP_USERNAME, NOT your normal password.
#   If SMTP_USERNAME/SMTP_PASSWORD are empty, OTP is printed to console (dev mode).
# ============================================================
# --- LLM Provider (gemini | openai | ollama) -----------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY_HERE>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY_HERE>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# --- LLM Model Selection ---
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o
# --- Vector Store (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma
# --- Audit Logging ---
AUDIT_LOG_DIR=./data/audit
AUDIT_LOG_FILENAME=compliance_audit.ndjson
# --- Document Uploads ---
UPLOAD_DIR=./data/uploads
# --- XSD Schema Directory ---
XSD_DIR=./data/xsd
# --- SQLite (Event Metadata) ---
SQLITE_DB_PATH=./data/events.db
# --- Server ---
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# --- Security / PII Masking ---
# Regex patterns that trigger PII masking in audit logs (comma-separated)
PII_MASK_PATTERNS=IBAN,account,SWIFT,customer_name
# --- Authentication / JWT ---
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_256BIT_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# --- Default Admin Account (seeded on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@complianceleader.io
# --- Database (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./data/compliance.db
# ─── Email / OTP (Gmail SMTP) ────────────────────────────────────────────────
# Get your App Password at: https://myaccount.google.com/apppasswords
# Leave empty to use console-fallback (dev mode — OTP prints in terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=              # your@gmail.com
SMTP_PASSWORD=              # 16-char App Password, e.g. abcd efgh ijkl mnop
SMTP_FROM_NAME=Compliance Leader
SMTP_ENABLED=True
# --- OTP Policy ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
# --- Account Lockout (banking grade) ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
SESSION_TIMEOUT_MINUTES=120
